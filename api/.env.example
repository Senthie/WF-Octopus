# ==================== Application ====================
APP_NAME="APP Octopus"
DEBUG=false
HOST=0.0.0.0
PORT=8000
SECRET_KEY=bdd51b437a9d3cb41e46864162cbfdf5b7f98cd78b2fb554

# ==================== Security ====================
JWT_SECRET_KEY=ddab1258b173e67b90f8d34227052e9679e282780077b61d
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== Database - PostgreSQL ====================
# 主数据库连接串（优先级高于下方单独变量）
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/lowcode_platform
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# PostgreSQL 单独配置（用于 docker-compose 或显式连接参数）
POSTGRES_DB=lowcode_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ==================== MongoDB ====================
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=lowcode_platform

# MongoDB 额外配置（认证、文件库等）
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=admin123
MONGO_DATABASE=lowcode_files
MONGO_PORT=27017

# ==================== Redis ====================
REDIS_URL=redis://14.12.0.102:6379
REDIS_DB=0
REDIS_MAX_CONNECTIONS=10


# ==================== Sentry ====================
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ==================== Logging ====================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ==================== File Upload ====================
MAX_UPLOAD_SIZE=104857600  # 100MB (GridFS 整体文件大小限制)
GRIDFS_THRESHOLD=16777216  # 16MB (超过此大小使用 GridFS)
MAX_FILE_SIZE=10485760     # 10MB (常规文件上传限制)
ALLOWED_FILE_TYPES=["image/jpeg","image/png","image/gif","application/pdf","text/plain"]

# ==================== CORS ====================
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET","POST","PUT","DELETE","OPTIONS"]
CORS_ALLOW_HEADERS=["*"]

# ==================== Email (SMTP) ====================
# 企业微信邮箱 (推荐)
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
# Gmail
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# 163邮箱
# SMTP_HOST=smtp.163.com
# SMTP_PORT=587

SMTP_USERNAME=your-email@yourcompany.com
SMTP_PASSWORD=your-email-password
FROM_EMAIL=noreply@yourcompany.com
FRONTEND_URL=https://yourapp.com

# ==================== API ====================
API_V1_PREFIX=/api/v1
API_PORT=8000

# ==================== Cache ====================
CACHE_TTL=3600  # 1小时
CACHE_PREFIX=lowcode

# ==================== Docker (optional) ====================
NGINX_PORT=80
NGINX_SSL_PORT=443

# ==================== OLLAMA ====================

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=nomic-embed-text